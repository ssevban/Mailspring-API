(common) {
	header {
		X-Content-Type-Options nosniff
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Identity + metadata sync: what the client's rootURLForServer('identity') and the
# sync engine's IDENTITY_SERVER point at. Shared pages/assets and tracking URLs are
# NOT served here: /page and /asset contain user-supplied HTML/files and must not
# share an origin with the session cookie and the API.
id.{$DOMAIN} {
	import common
	header Strict-Transport-Security "max-age=31536000"

	@other_hosts_only path /page/* /asset/* /thread/* /o/* /open/* /link/*
	respond @other_hosts_only 404

	reverse_proxy api:5101 {
		# /deltas/<aid>/streaming is a long-lived newline-delimited stream
		flush_interval -1
	}
}

# Open/link tracking (open-tracking and link-tracking package.json serverUrl). Public.
link.{$DOMAIN} {
	import common

	@tracking path /o/* /open/* /link/*
	handle @tracking {
		reverse_proxy api:5101
	}
	handle {
		respond 404
	}
}

# Shared threads, activity report pages, uploaded assets, signature icons (SHARE_URL). Public.
share.{$DOMAIN} {
	import common

	@share path /page/* /asset/* /thread/* /signature-assets/* /robots.txt
	handle @share {
		reverse_proxy api:5101
	}
	handle {
		respond 404
	}
}
